--!strict
-- Plan task 7. Run: require(UnfairShared.Tests.PartyStateTests)() -> { passed, failed }

local Config = require(script.Parent.Parent.UnfairConfig)
local PartyState = require(script.Parent.Parent.PartyState)
local TeleportPayload = require(script.Parent.Parent.TeleportPayload)
local Harness = require(script.Parent.Harness)

local NOW = 1_800_000_000

local function expectOk(ok: boolean, err: string?, label: string?)
	Harness.truthy(ok, `{label or "call"} should succeed, got "{tostring(err)}"`)
end

local function expectFail(ok: boolean, err: string?, fragment: string, label: string)
	Harness.eq(ok, false, `{label} should fail`)
	Harness.truthy(err ~= nil and string.find(err, fragment, 1, true) ~= nil, `{label}: error "{tostring(err)}" should mention "{fragment}"`)
end

-- A room with players 1..n (class "C<id>"), player 1 leading.
local function roomWith(n: number): PartyState.State
	local state = PartyState.new()
	for id = 1, n do
		expectOk(PartyState.join(state, id, "C" .. id))
	end
	return state
end

local function ids(state: PartyState.State): string
	local list = {}
	for _, member in state.members do
		table.insert(list, tostring(member.userId))
	end
	return table.concat(list, ",")
end

local cases = Harness.new()

cases:add("new room is empty, open, default settings", function()
	local state = PartyState.new()
	Harness.eq(PartyState.count(state), 0)
	Harness.isNil(state.leaderUserId)
	Harness.eq(state.phase, "Open")
	Harness.eq(state.difficulty, Config.DefaultDifficulty)
	Harness.eq(state.enraged, false)
end)

cases:add("first player to join becomes leader", function()
	local state = roomWith(3)
	Harness.eq(state.leaderUserId, 1)
	Harness.truthy(PartyState.isLeader(state, 1), "1 leads")
	Harness.eq(PartyState.isLeader(state, 2), false)
	Harness.eq(ids(state), "1,2,3")
end)

cases:add("join accepts up to PartyMax and rejects the next one", function()
	local state = roomWith(Config.PartyMax)
	Harness.eq(PartyState.count(state), Config.PartyMax)
	local ok, err = PartyState.join(state, 99, "Warrior")
	expectFail(ok, err, "full", "join into a full room")
	Harness.eq(PartyState.count(state), Config.PartyMax)
end)

cases:add("join rejects duplicates and bad input", function()
	local state = roomWith(2)
	local ok, err = PartyState.join(state, 2, "Mage")
	expectFail(ok, err, "already", "duplicate join")
	ok, err = PartyState.join(state, "7", "Mage")
	expectFail(ok, err, "user id", "string user id")
	ok, err = PartyState.join(state, 0 / 0, "Mage")
	expectFail(ok, err, "user id", "NaN user id")
	ok, err = PartyState.join(state, 7, "")
	expectFail(ok, err, "class", "empty class")
	ok, err = PartyState.join(state, 7, nil)
	expectFail(ok, err, "class", "missing class")
	Harness.eq(PartyState.count(state), 2)
end)

cases:add("leader leaves: the longest-waiting member takes over", function()
	local state = roomWith(4)
	expectOk(PartyState.leave(state, 1))
	Harness.eq(state.leaderUserId, 2)
	expectOk(PartyState.leave(state, 2))
	Harness.eq(state.leaderUserId, 3)
	Harness.eq(ids(state), "3,4")
end)

cases:add("a non-leader leaving keeps the leader", function()
	local state = roomWith(3)
	expectOk(PartyState.leave(state, 2))
	Harness.eq(state.leaderUserId, 1)
	Harness.eq(ids(state), "1,3")
end)

cases:add("a late joiner does not jump the handoff queue", function()
	local state = roomWith(2)
	expectOk(PartyState.leave(state, 1)) -- 2 leads
	expectOk(PartyState.join(state, 9, "Mage"))
	expectOk(PartyState.leave(state, 2))
	Harness.eq(state.leaderUserId, 9)
end)

cases:add("leave rejects someone who is not in the room", function()
	local state = roomWith(2)
	local ok, err = PartyState.leave(state, 77)
	expectFail(ok, err, "not in room", "leave by stranger")
	Harness.eq(PartyState.count(state), 2)
end)

cases:add("the last player leaving resets the room, settings included", function()
	local state = roomWith(1)
	expectOk(PartyState.setConfig(state, 1, "Hellaven", true))
	expectOk(PartyState.leave(state, 1))
	Harness.eq(PartyState.count(state), 0)
	Harness.isNil(state.leaderUserId)
	Harness.eq(state.difficulty, Config.DefaultDifficulty)
	Harness.eq(state.enraged, false)
	Harness.eq(state.phase, "Open")
	-- and the next arrival leads a fresh party
	expectOk(PartyState.join(state, 5, "Mage"))
	Harness.eq(state.leaderUserId, 5)
end)

cases:add("only the leader can change settings", function()
	local state = roomWith(3)
	local ok, err = PartyState.setConfig(state, 2, "Easy", false)
	expectFail(ok, err, "leader", "member changing settings")
	ok, err = PartyState.setConfig(state, 999, "Easy", false)
	expectFail(ok, err, "leader", "stranger changing settings")
	Harness.eq(state.difficulty, Config.DefaultDifficulty)
	expectOk(PartyState.setConfig(state, 1, "Hardcore", true))
	Harness.eq(state.difficulty, "Hardcore")
	Harness.eq(state.enraged, true)
end)

cases:add("a new leader (after handoff) can change settings, the old one cannot", function()
	local state = roomWith(2)
	expectOk(PartyState.leave(state, 1))
	expectOk(PartyState.join(state, 1, "C1")) -- old leader comes back as a plain member
	local ok, err = PartyState.setConfig(state, 1, "Easy", false)
	expectFail(ok, err, "leader", "returning old leader")
	expectOk(PartyState.setConfig(state, 2, "Easy", false))
end)

cases:add("setConfig rejects unknown difficulty and bad enraged without changing anything", function()
	local state = roomWith(1)
	expectOk(PartyState.setConfig(state, 1, "Hardcore", true))
	local ok, err = PartyState.setConfig(state, 1, "Nightmare", false)
	expectFail(ok, err, "difficulty", "unknown difficulty")
	ok, err = PartyState.setConfig(state, 1, 3, false)
	expectFail(ok, err, "difficulty", "numeric difficulty")
	ok, err = PartyState.setConfig(state, 1, "Hellaven", "yes")
	expectFail(ok, err, "enraged", "string enraged")
	Harness.eq(state.difficulty, "Hardcore")
	Harness.eq(state.enraged, true)
end)

cases:add("Easy cannot be Enraged: asking for both is rejected and changes nothing", function()
	local state = roomWith(1)
	expectOk(PartyState.setConfig(state, 1, "Hardcore", false))
	local ok, err = PartyState.setConfig(state, 1, "Easy", true)
	expectFail(ok, err, "Easy", "Easy + Enraged")
	Harness.eq(state.difficulty, "Hardcore")
	Harness.eq(state.enraged, false)
end)

cases:add("switching to Easy clears Enraged; enraged = nil keeps the old value elsewhere", function()
	local state = roomWith(1)
	expectOk(PartyState.setConfig(state, 1, "Hardcore", true))
	expectOk(PartyState.setConfig(state, 1, "Easy", nil))
	Harness.eq(state.difficulty, "Easy")
	Harness.eq(state.enraged, false)
	expectOk(PartyState.setConfig(state, 1, "Hardcore", true))
	expectOk(PartyState.setConfig(state, 1, "Hellaven", nil))
	Harness.eq(state.enraged, true, "nil keeps Enraged on a non-Easy difficulty")
	expectOk(PartyState.setConfig(state, 1, "Easy", false))
	Harness.eq(state.enraged, false)
	expectOk(PartyState.setConfig(state, 1, "Hardcore", nil))
	Harness.eq(state.enraged, false, "Enraged does not come back by itself")
end)

cases:add("setClass changes only that member's class", function()
	local state = roomWith(3)
	expectOk(PartyState.setClass(state, 2, "Mage"))
	Harness.eq(state.members[1].class, "C1")
	Harness.eq(state.members[2].class, "Mage")
	local ok, err = PartyState.setClass(state, 77, "Mage")
	expectFail(ok, err, "not in room", "class by stranger")
	ok, err = PartyState.setClass(state, 2, "")
	expectFail(ok, err, "class", "empty class")
	Harness.eq(state.members[2].class, "Mage")
end)

cases:add("leader starts a countdown that ends CountdownSeconds later", function()
	local state = roomWith(2)
	local ok, err = PartyState.startCountdown(state, 2, NOW)
	expectFail(ok, err, "leader", "member starting")
	Harness.eq(state.phase, "Open")
	expectOk(PartyState.startCountdown(state, 1, NOW))
	Harness.eq(state.phase, "Countdown")
	Harness.eq(state.countdownEndsAt, NOW + Config.CountdownSeconds)
	ok, err = PartyState.startCountdown(state, 1, NOW)
	expectFail(ok, err, "already", "starting twice")
end)

cases:add("an empty room cannot start", function()
	local state = PartyState.new()
	local ok, err = PartyState.startCountdown(state, 1, NOW)
	expectFail(ok, err, "leader", "empty room start")
end)

cases:add("during the countdown joins and settings changes are refused", function()
	local state = roomWith(2)
	expectOk(PartyState.startCountdown(state, 1, NOW))
	local ok, err = PartyState.join(state, 9, "Mage")
	expectFail(ok, err, "starting", "join during countdown")
	ok, err = PartyState.setConfig(state, 1, "Easy", false)
	expectFail(ok, err, "countdown", "settings during countdown")
	Harness.eq(PartyState.count(state), 2)
end)

cases:add("anyone leaving cancels the countdown", function()
	local state = roomWith(3)
	expectOk(PartyState.startCountdown(state, 1, NOW))
	expectOk(PartyState.leave(state, 3))
	Harness.eq(state.phase, "Open")
	Harness.isNil(state.countdownEndsAt)

	expectOk(PartyState.startCountdown(state, 1, NOW))
	expectOk(PartyState.leave(state, 1)) -- the leader leaves mid-countdown
	Harness.eq(state.phase, "Open")
	Harness.eq(state.leaderUserId, 2)
end)

cases:add("the leader can cancel, others cannot", function()
	local state = roomWith(2)
	local ok, err = PartyState.cancelCountdown(state, 1)
	expectFail(ok, err, "no countdown", "cancel with none running")
	expectOk(PartyState.startCountdown(state, 1, NOW))
	ok, err = PartyState.cancelCountdown(state, 2)
	expectFail(ok, err, "leader", "member cancelling")
	Harness.eq(state.phase, "Countdown")
	expectOk(PartyState.cancelCountdown(state, 1))
	Harness.eq(state.phase, "Open")
	Harness.isNil(state.countdownEndsAt)
end)

cases:add("lock only works once the countdown has run out", function()
	local state = roomWith(2)
	local ok, err = PartyState.lock(state, NOW)
	expectFail(ok, err, "no countdown", "lock without countdown")
	expectOk(PartyState.startCountdown(state, 1, NOW))
	Harness.eq(PartyState.isCountdownDue(state, NOW + Config.CountdownSeconds - 1), false)
	ok, err = PartyState.lock(state, NOW + Config.CountdownSeconds - 1)
	expectFail(ok, err, "not finished", "early lock")
	Harness.eq(state.phase, "Countdown")
	Harness.truthy(PartyState.isCountdownDue(state, NOW + Config.CountdownSeconds), "due at the end")
	expectOk(PartyState.lock(state, NOW + Config.CountdownSeconds))
	Harness.eq(state.phase, "Locked")
end)

cases:add("a locked room rejects joins, class changes and settings changes", function()
	local state = roomWith(2)
	expectOk(PartyState.startCountdown(state, 1, NOW))
	expectOk(PartyState.lock(state, NOW + Config.CountdownSeconds))
	local ok, err = PartyState.join(state, 9, "Mage")
	expectFail(ok, err, "starting", "join while locked")
	ok, err = PartyState.setClass(state, 2, "Mage")
	expectFail(ok, err, "launching", "class while locked")
	ok, err = PartyState.setConfig(state, 1, "Easy", false)
	expectFail(ok, err, "countdown", "settings while locked")
	ok, err = PartyState.startCountdown(state, 1, NOW)
	expectFail(ok, err, "already", "start while locked")
	Harness.eq(PartyState.count(state), 2)
end)

cases:add("leaving a locked room removes the player but does not cancel the launch", function()
	local state = roomWith(3)
	expectOk(PartyState.startCountdown(state, 1, NOW))
	expectOk(PartyState.lock(state, NOW + Config.CountdownSeconds))
	expectOk(PartyState.leave(state, 2))
	Harness.eq(state.phase, "Locked")
	Harness.eq(ids(state), "1,3")
	-- even if everyone leaves, the room stays locked until finish() so nobody can slip in mid-launch
	expectOk(PartyState.leave(state, 1))
	expectOk(PartyState.leave(state, 3))
	Harness.eq(state.phase, "Locked")
	Harness.eq(PartyState.count(state), 0)
	local ok, err = PartyState.join(state, 9, "Mage")
	expectFail(ok, err, "starting", "join into an emptied locked room")
end)

cases:add("finish resets a locked room and refuses otherwise", function()
	local state = roomWith(2)
	expectOk(PartyState.setConfig(state, 1, "Hellaven", true))
	local ok, err = PartyState.finish(state)
	expectFail(ok, err, "not launching", "finish while open")
	expectOk(PartyState.startCountdown(state, 1, NOW))
	expectOk(PartyState.lock(state, NOW + Config.CountdownSeconds))
	expectOk(PartyState.finish(state))
	Harness.eq(PartyState.count(state), 0)
	Harness.eq(state.phase, "Open")
	Harness.eq(state.difficulty, Config.DefaultDifficulty)
	Harness.eq(state.enraged, false)
	expectOk(PartyState.join(state, 4, "Mage"))
end)

cases:add("reset works in place and keeps the same table", function()
	local state = roomWith(3)
	local members = state.members
	PartyState.reset(state)
	Harness.truthy(state.members == members, "same members table")
	Harness.eq(#members, 0)
end)

cases:add("snapshot of an empty room is nil", function()
	Harness.isNil(PartyState.snapshot(PartyState.new(), "p1"))
end)

cases:add("snapshot is a copy and builds a valid payload with the room's settings", function()
	local state = roomWith(3)
	expectOk(PartyState.setClass(state, 3, "Mage"))
	expectOk(PartyState.setConfig(state, 1, "TrueHardcore", true))
	local snapshot = PartyState.snapshot(state, "party-7") :: TeleportPayload.Party
	Harness.eq(snapshot.partyId, "party-7")
	Harness.eq(snapshot.leaderUserId, 1)
	Harness.eq(snapshot.difficulty, "TrueHardcore")
	Harness.eq(snapshot.enraged, true)
	Harness.eq(#snapshot.members, 3)
	Harness.eq(snapshot.members[3].class, "Mage")

	snapshot.members[1].class = "Tampered"
	Harness.eq(state.members[1].class, "C1", "snapshot must not alias the room")

	local payload, err = TeleportPayload.build(PartyState.snapshot(state, "party-7") :: TeleportPayload.Party, "run-1", NOW)
	Harness.isNil(err)
	Harness.truthy(payload ~= nil, "payload builds")
end)

cases:add("a room switched to Easy never produces an Enraged payload", function()
	local state = roomWith(2)
	expectOk(PartyState.setConfig(state, 1, "Hardcore", true))
	expectOk(PartyState.setConfig(state, 1, "Easy", nil))
	local payload = TeleportPayload.build(PartyState.snapshot(state, "party-7") :: TeleportPayload.Party, "run-1", NOW) :: TeleportPayload.Payload
	Harness.eq(payload.difficulty, "Easy")
	Harness.eq(payload.enraged, false)
end)

return function()
	return cases:run()
end
