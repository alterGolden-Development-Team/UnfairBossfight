local BY_TEXT = {}
for id, text in pairs(ORIGINAL) do
	BY_TEXT[text] = id
end

local api = { Original = ORIGINAL, Scripts = SCRIPTS }
 
function api.Translate(text, actor)
	if type(text) ~= "string" then
		return text
	end
	local id = BY_TEXT[text]
	if not id then
		return text
	end
	local script = SCRIPTS[Difficulty.Id(actor)]
	return script and script[id] or text
end
return api
